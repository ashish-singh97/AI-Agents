# --- Identity ---
SENDER_NAME=Your Name

# --- Email provider ---
EMAIL_PROVIDER=gmail

# --- Resume ---
# Absolute path to the resume file that will be attached to every email.
RESUME_PATH=/path/to/your_resume

# --- Sending behavior ---
# Must be explicitly set to true to send without interactive per-email confirmation.
AUTO_SEND=false
# If true, emails are generated but never sent (overridable with --dry-run flag too).
DRY_RUN=false

# --- Rate limiting ---
MIN_DELAY_SECONDS=30
MAX_DELAY_SECONDS=90
DAILY_EMAIL_LIMIT=30
# Set true only for local development/testing to skip delays.
DISABLE_RATE_LIMIT=false

# --- Gmail OAuth ---
# Path to the OAuth client secret downloaded from Google Cloud Console.
GMAIL_CREDENTIALS_PATH=credentials.json
# Path where the cached user token will be written after first authorization.
GMAIL_TOKEN_PATH=token.json

# --- Storage / logging ---
DATABASE_PATH=database/recruiter_agent.db
LOG_PATH=logs/agent.log


